        <node unique_id="239" master_id="0" name="ssh name@ip" prog_lang="custom-colors" tags="" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1794510692" ts_lastsave="1794510692"/>
